{
  "name": "@nemesis-oss/coindcx-sdk",
  "version": "1.3.0",
  "description": "Production-grade TypeScript SDK for CoinDCX Spot, Margin, and Futures trading with Socket.IO WebSocket support, local paper engine, risk ops, and MCP toolkits for trading agents",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./mcp": {
      "import": {
        "types": "./dist/mcp/index.d.mts",
        "default": "./dist/mcp/index.mjs"
      },
      "require": {
        "types": "./dist/mcp/index.d.ts",
        "default": "./dist/mcp/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "mcp": [
        "dist/mcp/index.d.ts"
      ]
    }
  },
  "bin": {
    "coindcx-mcp": "./dist/bin/mcp.cjs",
    "mcp": "./dist/bin/mcp.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "check:types": "npx --yes @arethetypeswrong/cli@latest --pack .",
    "smoke": "tsx scripts/smoke-test.ts",
    "mcp": "tsx bin/mcp.ts",
    "example:quickstart": "tsx examples/quickstart.ts",
    "example:paper": "tsx examples/paper-trading.ts",
    "example:ws": "tsx examples/ws-streams.ts",
    "docs:api": "typedoc",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:types",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run lint && npm test && npm run build && npm run check:types"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "coindcx",
    "crypto",
    "futures",
    "spot",
    "margin",
    "trading",
    "sdk",
    "typescript",
    "websocket",
    "socket.io",
    "paper-trading",
    "risk",
    "mcp",
    "ai-agent"
  ],
  "author": "Shubham Taywade <shubhamtaywade82@gmail.com>",
  "license": "ISC",
  "homepage": "https://github.com/shubhamtaywade82/coindcx-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubhamtaywade82/coindcx-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/shubhamtaywade82/coindcx-sdk/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "axios": "^1.6.0",
    "eventemitter3": "^5.0.1",
    "socket.io-client": "^4.7.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@pollyjs/adapter-node-http": "^6.0.6",
    "@pollyjs/core": "^6.0.6",
    "@pollyjs/persister-fs": "^6.0.6",
    "@types/jest": "^29.5.11",
    "@types/nock": "^11.1.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nock": "^13.4.0",
    "ts-jest": "^29.1.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.3.0"
  }
}
